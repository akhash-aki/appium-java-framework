<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="iOS Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.framework.listeners.TestListener" />
    </listeners>

    <test name="iOS Regression">
        <parameter name="platform" value="IOS" />
        <parameter name="deviceName" value="iPhone 15 Pro" />
        <classes>
            <class name="com.framework.tests.LoginTest" />
        </classes>
    </test>
</suite>
